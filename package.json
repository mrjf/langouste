{
  "name": "langouste",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,hono -c blue,green \"vite dev\" \"bun --watch src/main.ts\"",
    "dev:server": "bun --watch src/main.ts",
    "dev:client": "vite dev",
    "build": "vite build",
    "start": "bun src/main.ts",
    "test": "bun test tests/services",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:all": "bun run test && bun run test:e2e",
    "migrate": "bun scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.112",
    "@anthropic-ai/sdk": "^0.39.0",
    "@google-cloud/translate": "^9.3.0",
    "@supabase/supabase-js": "^2.49.0",
    "dictionary-de": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-hu": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-nl": "^2.0.0",
    "dictionary-pl": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "dictionary-ru": "^3.0.0",
    "dictionary-tr": "^2.0.0",
    "hono": "^4.4.0",
    "nspell": "^2.1.5",
    "tinyld": "^1.3.4",
    "transliteration": "^2.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "concurrently": "^9.2.1",
    "svelte": "^5.55.1",
    "vite": "^5.4.0"
  }
}
