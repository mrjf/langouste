{
  "name": "langouste",
  "version": "0.0.0",
  "description": "Open-source language-learning chat with AI agents, correction, translation, and spaced repetition.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrjf/langouste.git"
  },
  "bugs": {
    "url": "https://github.com/mrjf/langouste/issues"
  },
  "homepage": "https://github.com/mrjf/langouste#readme",
  "type": "module",
  "exports": {
    "./audio": "./src/services/ai/audio/synthesis.ts",
    "./audio-player": "./src/client/lib/audio-player.ts",
    "./dictionary": "./src/services/references/dictionary.ts",
    "./dictionary-popover": {
      "svelte": "./src/client/components/DictionaryPopover.svelte",
      "default": "./src/client/components/DictionaryPopover.svelte"
    },
    "./reading-profile": "./src/services/reading/profile.ts"
  },
  "scripts": {
    "preflight": "bun scripts/preflight.ts",
    "dev": "bun run preflight && concurrently -k -n vite,hono -c blue,green \"vite dev\" \"bun --watch src/main.ts\"",
    "dev:server": "bun run preflight && bun --watch src/main.ts",
    "dev:client": "vite dev",
    "build": "vite build",
    "start": "bun run preflight && bun src/main.ts",
    "lint": "biome lint src tests scripts",
    "lint:fix": "biome check --write src tests scripts",
    "format": "biome format --write src tests scripts",
    "format:check": "biome format src tests scripts",
    "check": "biome check src tests scripts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.check.json",
    "test": "bun test --preload ./tests/services/_db-harness.ts tests/services",
    "test:evals": "bun test tests/evals",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:e2e:real": "bunx playwright test --config playwright.config.real.ts",
    "test:e2e:openclaw": "bunx playwright test --config playwright.config.real.ts tests/e2e-real/openclaw.spec.ts",
    "test:e2e:claude": "bunx playwright test --config playwright.config.real.ts tests/e2e-real/claude.spec.ts",
    "test:e2e:claude-code": "bunx playwright test --config playwright.config.real.ts tests/e2e-real/claude-code.spec.ts",
    "test:all": "bun run test && bun run test:e2e",
    "test:all:real": "bun run test && bun run test:e2e && bun run test:e2e:real",
    "migrate": "bun scripts/migrate.ts",
    "import:turbopuffer": "bun scripts/import-turbopuffer.ts",
    "backfill:filo": "bun scripts/backfill-filo-docs.ts",
    "build:audio-drill-tape": "bun scripts/build-audio-drill-tape.ts",
    "build:cloudflare": "bun scripts/build-cloudflare.ts",
    "typecheck:cloudflare": "tsc --project tsconfig.cloudflare.json",
    "audio:course": "bun scripts/course-audio.ts",
    "build:static": "bun scripts/build-cloudflare.ts --static",
    "check:static-publish": "bun scripts/check-static-publish.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.112",
    "@anthropic-ai/sdk": "^0.110.0",
    "@google-cloud/translate": "^9.3.0",
    "@mozilla/readability": "^0.6.0",
    "@piper-plus/g2p": "^0.4.0",
    "@turbopuffer/turbopuffer": "^2.6.0",
    "bcryptjs": "^3.0.3",
    "dictionary-de": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-hu": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-nl": "^2.0.0",
    "dictionary-pl": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "dictionary-ru": "^3.0.0",
    "dictionary-tr": "^2.0.0",
    "filo": "file:./filo",
    "hono": "^4.12.27",
    "linkedom": "^0.18.12",
    "nspell": "^2.1.5",
    "phonemize": "^1.2.0",
    "sanitize-html": "^2.17.5",
    "tinyld": "^1.3.4",
    "transliteration": "^2.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@types/sanitize-html": "^2.16.1",
    "bun-types": "1.3.14",
    "concurrently": "^9.2.1",
    "svelte": "^5.56.4",
    "svelte-check": "4.4.8",
    "typescript": "6.0.3",
    "vite": "^6.4.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.1"
  }
}
