# ============================================================================
# Langouste environment configuration
# ============================================================================
#
# Pick a database mode below, fill in the matching block, and delete the rest.
# Default is sqlite (zero-config local run).

# ----------------------------------------------------------------------------
# SQLite mode (default) — fully local, no external services
# ----------------------------------------------------------------------------
#
# Run `bun run migrate` once to create the local schema. The DB file lives in
# LANGOUSTE_DATA_DIR (defaults to ~/Library/Application Support/Langouste on
# macOS, $XDG_DATA_HOME/langouste on Linux, %APPDATA%/Langouste on Windows).

DATABASE_MODE=sqlite

# Any long random string works. Generate one with:
#   bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
LANGOUSTE_JWT_SECRET=change-me-to-something-long-and-random

# Optional: override the data directory (e.g. to put it under the repo for dev).
# LANGOUSTE_DATA_DIR=./data

# Mirror DATABASE_MODE to the browser build so the client knows to skip
# Supabase Realtime.
VITE_DATABASE_MODE=sqlite

# Single-user mode: skip signup/login entirely and auto-issue a session for a
# local-only user on first boot. Defaults on in sqlite mode; set to false if
# you want multi-user login locally.
VITE_SINGLE_USER=true
# LANGOUSTE_SINGLE_USER=true  # only needed if you want to override the default

# ----------------------------------------------------------------------------
# Supabase mode — managed or self-hosted Supabase with Auth + Realtime + RLS
# ----------------------------------------------------------------------------
#
# Uncomment this block and comment out the sqlite block above to use Supabase.
# Run `bun run migrate` to apply migrations via the Supabase Management API
# (requires `supabase login` first).
#
# DATABASE_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SECRET_KEY=your-secret-key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# VITE_DATABASE_MODE=supabase

# ----------------------------------------------------------------------------
# AI providers (required in every mode)
# ----------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-your-key

# Translation provider: "claude" (default) or "google-tllm".
# "google-tllm" needs GOOGLE_APPLICATION_CREDENTIALS + GOOGLE_CLOUD_PROJECT.
TRANSLATION_PROVIDER=claude
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

PORT=8000
