# ============================================================================
# Langouste environment configuration
# ============================================================================
#
# turbopuffer is the sole persistence and search engine. Successful writes are
# committed by turbopuffer to object storage; you do not configure an S3 bucket
# for normal rows or inline Filo source documents.
TURBOPUFFER_API_KEY=tpuf_your-key
TURBOPUFFER_REGION=aws-us-west-2
# Isolate environments and deployments with distinct prefixes.
TURBOPUFFER_NAMESPACE_PREFIX=langouste-dev
# Optional for BYOC/proxy/test endpoints:
# TURBOPUFFER_BASE_URL=https://your-turbopuffer-endpoint

# Any long random string works. Generate one with:
#   bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
LANGOUSTE_JWT_SECRET=change-me-to-something-long-and-random

# Single-user mode: skip signup/login entirely and auto-issue a session for a
# fixed user on first boot. Defaults on; set both values false for signup/login.
VITE_SINGLE_USER=true
# LANGOUSTE_SINGLE_USER=true

# ----------------------------------------------------------------------------
# AI providers (required in every mode)
# ----------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-your-key

# Translation provider: "claude" (default) or "google-tllm".
# "google-tllm" needs GOOGLE_APPLICATION_CREDENTIALS + GOOGLE_CLOUD_PROJECT.
TRANSLATION_PROVIDER=claude
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project

# How the agent is asked to use the target language:
# "target-first" (default) or "english-mediated".
# LANGOUSTE_AGENT_LANGUAGE_STRATEGY=target-first

# News tab: multilingual article editions use Sonnet by default. The cache is
# a rebuildable local artifact; completed editions are saved in turbopuffer.
# LANGOUSTE_NEWS_MODEL=claude-sonnet-4-6
# LANGOUSTE_NEWS_MAX_SENTENCES=14
# LANGOUSTE_NEWS_CACHE_DIR=./data/news-cache

# Spell-check provider — a swappable async boundary (SpellCheckProvider).
# Default "noop": no deterministic spell-check; Opus still explains
# spelling+grammar on every message. The bundled in-process "nspell"
# provider is NOT recommended — its Hunspell dictionary init is synchronous
# and blocks the server event loop (fr ~1.8s, pl ~4.8s, pt ~7.9s, Hungarian
# = minutes). "languagetool" calls the LanguageTool API (adds English +
# grammar). Future: separate per-language spelling services behind this
# same interface. Leave as noop unless you know what you're doing.
SPELLCHECK_PROVIDER=noop
# LANGUAGETOOL_URL=https://api.languagetool.org/v2  # only if =languagetool

# ----------------------------------------------------------------------------
# Text-to-speech (optional) — speaker buttons on messages/translations
# ----------------------------------------------------------------------------
#
# Disabled by default. Set AUDIO_PROVIDER=elevenlabs + an API key to enable.

# AUDIO_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your-elevenlabs-key

# Per-language voice + model map (JSON object keyed by ISO 639-1 language).
# Each entry: { "voiceId": required, "model"?: optional, "languageCode"?: optional }.
#
# Why this matters: eleven_multilingual_v2 does NOT support Hungarian (or
# Vietnamese/Norwegian) — those languages exist only on the v2.5 models.
# Any language without an entry defaults to model "eleven_turbo_v2_5" with
# language_code set, which covers all 32 supported languages. For materially
# better non-English speech, set a voice that the language actually suits
# (pick voice IDs from your ElevenLabs account / Voice Library).
#
# "model" defaults to eleven_turbo_v2_5. "languageCode" defaults to the map
# key on v2.5 models; set it to "" to force-omit, or to a specific code
# (e.g. map "pt-BR" -> languageCode "pt"). Only v2.5 models accept it.
#
# ELEVENLABS_VOICES={"hu":{"voiceId":"YOUR_HU_VOICE_ID","model":"eleven_turbo_v2_5"},"default":{"voiceId":"EXAVITQu4vr4xnSDxMaL"}}
#
# Legacy single global voice (still honored as the "default" entry if
# ELEVENLABS_VOICES has no "default" key):
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

PORT=8000

# Verbose OpenClaw gateway frame logging (dev only). Set to 1 to enable.
# LANGOUSTE_OPENCLAW_DEBUG=1
