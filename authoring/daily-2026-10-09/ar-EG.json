  "concepts": [
    {
      "id": "ar-EG-oct09-grammar-1",
      "title": "A polite request with momken",
      "explanation": "Momken before a verb makes a request: “could you…?” Teʿeed addresses one man; teʿeedi addresses one woman. Momken ashrah asks “may I explain?” Learn the person-specific verb forms as short chunks.",
      "examples": [
        {
          "id": "ai-news-2026-10-09-ar-EG-s026",
          "text": "ممكن تعيد السؤال؟",
          "english": "Could you repeat the question?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "momken teʿeed es-soʾaal?"
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s027",
          "text": "ممكن تعيدي السؤال؟",
          "english": "Could you repeat the question?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "momken teʿeedi es-soʾaal?"
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s028",
          "text": "ممكن أشرح المشكلة؟",
          "english": "May I explain the problem?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "momken ashrah el-moshkela?"
        }
      ]
    },
    {
      "id": "ar-EG-oct09-grammar-2",
      "title": "Say what you need",
      "explanation": "A female speaker says mehtaaga, while a male speaker says mehtaag. Both mean “needing / I need” in these examples. Put mosaaʿda after it. Mesh before an adjective negates a description; no separate present-tense “is” is needed.",
      "examples": [
        {
          "id": "ai-news-2026-10-09-ar-EG-s029",
          "text": "محتاجة مساعدة.",
          "english": "I need help.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "mehtaaga mosaaʿda."
        },
        {
