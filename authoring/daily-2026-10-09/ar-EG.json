  "readings": [
    {
      "id": "ai-news-2026-10-09-ar-EG-r1",
      "title": "AI calls with a supervisor · October 8 announcement",
      "sentences": [
        {
          "id": "ai-news-2026-10-09-ar-EG-s001",
          "text": "شركة Sanas أعلنت عن أداة جديدة.",
          "english": "Sanas announced a new tool.",
          "kind": "source-summary",
          "sourceIds": [
            "sanas_supervised_calls_2026_10_08"
          ],
          "transliteration": "sherket Sanas aʿlanet ʿan adaa gedeeda."
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s002",
          "text": "حسب الشركة، الذكاء الاصطناعي بيرد على المكالمات.",
          "english": "According to the company, AI answers the calls.",
          "kind": "source-summary",
          "sourceIds": [
            "sanas_supervised_calls_2026_10_08"
          ],
          "transliteration": "hasab esh-sherka, ez-zakaaʾ el-estenaaʿi beyerodd ʿala el-mokalmaat."
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s003",
          "text": "ومشرف بيتابع المكالمات.",
          "english": "And a supervisor monitors the calls.",
          "kind": "source-summary",
          "sourceIds": [
            "sanas_supervised_calls_2026_10_08"
          ],
          "transliteration": "we-moshref beytaabeʿ el-mokalmaat."
        }
      ]
    },
    {
      "id": "ai-news-2026-10-09-ar-EG-r2",
      "title": "Please repeat that · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-09-ar-EG-s004",
          "text": "منى: ألو، الصوت مش واضح.",
          "english": "Mona: Hello, the sound is not clear.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: alo, es-soot mesh waadeh."
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s005",
          "text": "كريم: ممكن تعيدي السؤال؟",
          "english": "Karim: Could you repeat the question?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: momken teʿeedi es-soʾaal?"
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s006",
          "text": "منى: عندي مشكلة في الصفحة.",
          "english": "Mona: I have a problem with the page.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: ʿandi moshkela fi es-safha."
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s007",
          "text": "كريم: ثانية واحدة، من فضلك.",
          "english": "Karim: One second, please.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: sanya waahda, men fadlik."
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s008",
          "text": "منى: أيوه، أنا مستنية.",
          "english": "Mona: Yes, I am waiting.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: aywa, ana mestanneyya."
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s009",
          "text": "كريم: دلوقتي الصوت واضح؟",
          "english": "Karim: Is the sound clear now?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: delwaʾti es-soot waadeh?"
        }
      ]
    },
    {
      "id": "ai-news-2026-10-09-ar-EG-r3",
      "title": "Ask for help · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-09-ar-EG-s010",
          "text": "منى: أيوه، بس لسه عندي مشكلة.",
          "english": "Mona: Yes, but I still have a problem.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: aywa, bass lissa ʿandi moshkela."
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s011",
          "text": "كريم: تحبي تتكلمي مع موظف؟",
          "english": "Karim: Would you like to speak with an employee?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: tehebbi tetkallemi maʿa mowazzaf?"
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s012",
          "text": "منى: أيوه، محتاجة مساعدة.",
          "english": "Mona: Yes, I need help.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: aywa, mehtaaga mosaaʿda."
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s013",
          "text": "كريم: الموظف معانا دلوقتي.",
          "english": "Karim: The employee is with us now.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: el-mowazzaf maʿaana delwaʾti."
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s014",
          "text": "منى: شكراً، ممكن أشرح المشكلة؟",
          "english": "Mona: Thanks, may I explain the problem?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: shokran, momken ashrah el-moshkela?"
        },
        {
          "id": "ai-news-2026-10-09-ar-EG-s015",
          "text": "كريم: أكيد، اتفضلي.",
          "english": "Karim: Of course, go ahead.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: akeed, etfaddali."
        }
      ]
    }
