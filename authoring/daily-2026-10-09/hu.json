  "concepts": [
    {
      "id": "hu-oct09-grammar-1",
      "title": "Open it; fill it out",
      "explanation": "Megnyitom and kitöltöm are complete forms for “I open it” and “I fill it out”. With a specific object, use the definite article and the object ending: az oldalt, az űrlapot. Beírok egy nevet uses an unspecified “a name”; név changes to nevet.",
      "examples": [
        {
          "id": "ai-news-2026-10-09-hu-s026",
          "text": "Megnyitom az oldalt.",
          "english": "I open the page.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-09-hu-s027",
          "text": "Kitöltöm az űrlapot.",
          "english": "I fill out the form.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-09-hu-s028",
          "text": "Beírok egy nevet.",
          "english": "I enter a name.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    },
    {
      "id": "hu-oct09-grammar-2",
      "title": "Not ready yet; ready now",
      "explanation": "Még nem kész means “not ready yet”. Most már kész means “now it is ready”, marking a change. In these third-person present descriptions, Hungarian has no separate word for “is”. The same pattern works for an empty field.",
      "examples": [
        {
          "id": "ai-news-2026-10-09-hu-s029",
          "text": "Még nem kész.",
          "english": "It is not ready yet.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-09-hu-s030",
          "text": "Most már kész.",
          "english": "Now it is ready.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-09-hu-s031",
          "text": "A mező nem üres.",
          "english": "The field is not empty.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    }
  ],
