  "concepts": [
    {
      "id": "ar-EG-oct11-grammar-1",
      "title": "Is there a connection?",
      "explanation": "Fi means there is or there are. With question intonation it asks whether something exists. Mafeesh, written مفيش, means there is not or there are not. Hena places it here.",
      "examples": [
        {
          "id": "ai-news-2026-10-11-ar-EG-s026",
          "text": "في إنترنت هنا؟",
          "english": "Is there internet here?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "fi internet hena?"
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s027",
          "text": "مفيش إنترنت هنا.",
          "english": "There is no internet here.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "mafeesh internet hena."
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s028",
          "text": "في اتصال دلوقتي.",
          "english": "There is a connection now.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "fi ettesaal delwaʾti."
        }
      ]
    },
    {
      "id": "ar-EG-oct11-grammar-2",
      "title": "Working or not working",
      "explanation": "Use mesh before an adjective to negate a description: el-bernaameg mesh shaghghaal. Maʾtooʿ means disconnected or down for a connection. No separate present-tense “is” is needed. Do not confuse mafeesh (there is no) with mesh (not).",
      "examples": [
        {
          "id": "ai-news-2026-10-11-ar-EG-s029",
          "text": "البرنامج شغال.",
          "english": "The program is working.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "el-bernaameg shaghghaal."
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s030",
          "text": "البرنامج مش شغال.",
          "english": "The program is not working.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "el-bernaameg mesh shaghghaal."
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s031",
          "text": "الاتصال مقطوع.",
          "english": "The connection is down.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "el-ettesaal maʾtooʿ."
        }
      ]
    }
  ],
