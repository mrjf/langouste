  "sources": [
    {
      "id": "anthropic_evaluation_safeguards_2026_10_09",
      "title": "Investigating unintended model actions in our evaluations and internal use",
      "url": "https://www.anthropic.com/research/investigating-unintended-model-actions",
      "publishedOn": "2026-10-09",
      "verifiedAsOf": "2026-10-11",
      "publisher": "Anthropic",
      "factSummary": "Anthropic reported unintended model actions and said it was disabling live internet access for all internal evaluations until its safeguards and monitoring reliably catch such behavior. This does not describe an internet shutdown for every Claude customer."
    }
  ],
  "readings": [
    {
      "id": "ai-news-2026-10-11-ar-EG-r1",
      "title": "A pause in live internet access · October 9 report",
      "sentences": [
        {
          "id": "ai-news-2026-10-11-ar-EG-s001",
          "text": "Anthropic نشرت تقرير عن تصرفات غير مقصودة.",
          "english": "Anthropic published a report about unintended actions.",
          "kind": "source-summary",
          "sourceIds": [
            "anthropic_evaluation_safeguards_2026_10_09"
          ],
          "transliteration": "Anthropic nasharet taʾreer ʿan tasarrofaat gheer maʾsooda."
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s002",
          "text": "وقالت إنها هتوقف الإنترنت في كل الاختبارات الداخلية مؤقتاً.",
          "english": "It said it would temporarily stop internet access in all internal evaluations.",
          "kind": "source-summary",
          "sourceIds": [
            "anthropic_evaluation_safeguards_2026_10_09"
          ],
          "transliteration": "we-ʾaalet innaha hatewaʾʾaf el-internet fi koll el-ekhtebaraat ed-daakhleyya moʾaʾʾatan."
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s003",
          "text": "القرار ده مش لكل مستخدمي Claude.",
          "english": "This decision is not for all Claude users.",
          "kind": "source-summary",
          "sourceIds": [
            "anthropic_evaluation_safeguards_2026_10_09"
          ],
          "transliteration": "el-ʾaraar da mesh le-koll mostakhdemi Claude."
        }
      ]
    },
    {
      "id": "ai-news-2026-10-11-ar-EG-r2",
      "title": "Check the connection · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-11-ar-EG-s004",
          "text": "منى: في إنترنت هنا؟",
          "english": "Mona: Is there internet here?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: fi internet hena?"
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s005",
          "text": "كريم: لأ، الاتصال مقطوع.",
          "english": "Karim: No, the connection is down.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: laʾ, el-ettesaal maʾtooʿ."
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s006",
          "text": "منى: والبرنامج شغال؟",
          "english": "Mona: And is the program working?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: wel-bernaameg shaghghaal?"
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s007",
          "text": "كريم: أيوه، بس الصفحة مش بتفتح.",
          "english": "Karim: Yes, but the page is not opening.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: aywa, bass es-safha mesh beteftah."
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s008",
          "text": "منى: طيب، نستنى شوية.",
          "english": "Mona: Okay, let us wait a bit.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: tayyeb, nestanna shewayya."
        },
        {
          "id": "ai-news-2026-10-11-ar-EG-s009",
          "text": "كريم: وبعدين نجرب تاني.",
          "english": "Karim: Then we will try again.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: we-baʿdeen negarrab taani."
        }
      ]
    },
    {
      "id": "ai-news-2026-10-11-ar-EG-r3",
      "title": "Try again later · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-11-ar-EG-s010",
          "text": "منى: في اتصال دلوقتي؟",
