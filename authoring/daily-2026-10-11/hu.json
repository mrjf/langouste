  "concepts": [
    {
      "id": "hu-oct11-grammar-1",
      "title": "In this folder; in that folder",
      "explanation": "Use -ban or -ben for in. Mappa becomes mappában: final a lengthens to á. With this or that, the demonstrative also takes the ending: ebben a mappában, abban a mappában. Keep the article a between them.",
      "examples": [
        {
          "id": "ai-news-2026-10-11-hu-s026",
          "text": "Ebben a mappában van.",
          "english": "It is in this folder.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s027",
          "text": "Abban a mappában van.",
          "english": "It is in that folder.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s028",
          "text": "Melyik mappában van?",
          "english": "Which folder is it in?",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    },
    {
      "id": "hu-oct11-grammar-2",
      "title": "Save a specific file",
      "explanation": "Elmentem is the complete first-person definite form for I save it in this context. A specific object takes -t: a fájlt, a másolatot. In Itt a friss másolat, the adjective precedes the noun and there is no separate is.",
      "examples": [
        {
          "id": "ai-news-2026-10-11-hu-s029",
          "text": "Elmentem a fájlt.",
          "english": "I save the file.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s030",
          "text": "Elmentem a másolatot.",
          "english": "I save the copy.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s031",
          "text": "Itt a friss másolat.",
          "english": "Here is the latest copy.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    }
  ],
