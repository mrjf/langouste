    {
      "id": "ai-news-2026-10-11-hu-r2",
      "title": "Save a copy · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-11-hu-s004",
          "text": "Anna: Hol van a fájl?",
          "english": "Anna: Where is the file?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s005",
          "text": "Bence: Ebben a mappában.",
          "english": "Bence: In this folder.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s006",
          "text": "Anna: Ez a régi változat?",
          "english": "Anna: Is this the old version?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s007",
          "text": "Bence: Igen. Itt a friss másolat.",
          "english": "Bence: Yes. Here is the latest copy.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s008",
          "text": "Anna: Elmentem a másolatot.",
          "english": "Anna: I will save the copy.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s009",
          "text": "Bence: Jó, nézd meg a dátumot is!",
          "english": "Bence: Good, check the date too!",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    },
    {
      "id": "ai-news-2026-10-11-hu-r3",
      "title": "Find it again · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-11-hu-s010",
          "text": "Anna: Melyik mappában van?",
          "english": "Anna: Which folder is it in?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s011",
          "text": "Bence: Abban a mappában.",
          "english": "Bence: In that folder.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s012",
          "text": "Anna: Megvan! A dátum jó.",
          "english": "Anna: Found it! The date is correct.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s013",
          "text": "Bence: Megnyitod a fájlt?",
          "english": "Bence: Will you open the file?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s014",
          "text": "Anna: Igen. A másolat kész.",
          "english": "Anna: Yes. The copy is ready.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-11-hu-s015",
          "text": "Bence: Akkor folytathatjuk.",
          "english": "Bence: Then we can continue.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    }
