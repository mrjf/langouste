  "sources": [
    {
      "id": "anthropic_workflows_2026_10_09",
      "title": "Claude Platform release notes: October 9, 2026",
      "url": "https://platform.claude.com/docs/en/release-notes/overview#october-9-2026",
      "publishedOn": "2026-10-09",
      "verifiedAsOf": "2026-10-10",
      "publisher": "Anthropic",
      "factSummary": "Anthropic announced dynamic workflows in beta for Claude Managed Agents. These programs run agents in phases and combine results, including for work such as reviewing many documents."
    }
  ],
  "readings": [
    {
      "id": "ai-news-2026-10-10-ar-EG-r1",
      "title": "Work in phases · October 9 beta release",
      "sentences": [
        {
          "id": "ai-news-2026-10-10-ar-EG-s001",
          "text": "Anthropic أعلنت عن ميزة جديدة.",
          "english": "Anthropic announced a new feature.",
          "kind": "source-summary",
          "sourceIds": [
            "anthropic_workflows_2026_10_09"
          ],
          "transliteration": "Anthropic aʿlanet ʿan meeza gedeeda."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s002",
          "text": "الميزة بتشغّل وكلاء AI على مراحل.",
          "english": "The feature runs AI agents in phases.",
          "kind": "source-summary",
          "sourceIds": [
            "anthropic_workflows_2026_10_09"
          ],
          "transliteration": "el-meeza betshagghal wokalaaʾ AI ʿala maraahel."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s003",
          "text": "وبتجمع النتايج. الميزة لسه تجريبية.",
          "english": "And it combines results. The feature is still in beta.",
          "kind": "source-summary",
          "sourceIds": [
            "anthropic_workflows_2026_10_09"
          ],
          "transliteration": "we-betgammaʿ en-nataayeg. el-meeza lissa tagreebeyya."
        }
      ]
    },
    {
      "id": "ai-news-2026-10-10-ar-EG-r2",
      "title": "Divide the work · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-10-ar-EG-s004",
          "text": "منى: عندنا تلات ملفات.",
          "english": "Mona: We have three files.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: ʿandena talaat malaffaat."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s005",
          "text": "كريم: نبدأ بإيه؟",
          "english": "Karim: What shall we start with?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: nebdaʾ be-eh?"
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s006",
          "text": "منى: نقسم الشغل الأول.",
          "english": "Mona: Let us divide the work first.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: neʾsem esh-shoghl el-awwal."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s007",
          "text": "كريم: أنا هاخد الملف ده.",
          "english": "Karim: I will take this file.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: ana haakhod el-malaff da."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s008",
          "text": "منى: تمام، وأنا هاخد الملف التاني.",
          "english": "Mona: Great, and I will take the second file.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: tamaam, we-ana haakhod el-malaff et-taani."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s009",
          "text": "كريم: وبعدين نراجع النتايج سوا.",
          "english": "Karim: Then we will review the results together.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: we-baʿdeen neraageʿ en-nataayeg sawa."
        }
      ]
    },
    {
      "id": "ai-news-2026-10-10-ar-EG-r3",
      "title": "One step at a time · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-10-ar-EG-s010",
          "text": "منى: خلصت الخطوة الأولى؟",
          "english": "Mona: Have you finished the first step?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: khallast el-khatwa el-oola?"
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s011",
          "text": "كريم: لسه، محتاج دقيقة.",
          "english": "Karim: Not yet, I need a minute.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: lissa, mehtaag deʾeeʾa."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s012",
          "text": "منى: ماشي، أنا جاهزة.",
          "english": "Mona: Okay, I am ready.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: maashi, ana gahza."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s013",
          "text": "كريم: دلوقتي خلصت.",
          "english": "Karim: Now I have finished.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: delwaʾti khallast."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s014",
          "text": "منى: نراجع سوا؟",
          "english": "Mona: Shall we review together?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: neraageʿ sawa?"
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s015",
          "text": "كريم: أيوه، خطوة خطوة.",
          "english": "Karim: Yes, step by step.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: aywa, khatwa khatwa."
        }
      ]
    }
