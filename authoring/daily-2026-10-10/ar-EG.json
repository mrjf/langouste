  "concepts": [
    {
      "id": "ar-EG-oct10-grammar-1",
      "title": "Suggest a shared action",
      "explanation": "The n- verb forms here mean “we”: neʾsem, we divide; neraageʿ, we review. In context they also suggest “let us”. Add sawa to mean together. Nebdaʾ be-eh? asks what to start with.",
      "examples": [
        {
          "id": "ai-news-2026-10-10-ar-EG-s026",
          "text": "نقسم الشغل.",
          "english": "Let us divide the work.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "neʾsem esh-shoghl."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s027",
          "text": "نراجع سوا.",
          "english": "Let us review together.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "neraageʿ sawa."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s028",
          "text": "نبدأ بإيه؟",
          "english": "What shall we start with?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "nebdaʾ be-eh?"
        }
      ]
    },
    {
      "id": "ar-EG-oct10-grammar-2",
      "title": "I will take; I am ready",
      "explanation": "Haakhod is a useful future chunk: “I will take”. For readiness a man says gahez, a woman gahza. No separate present-tense “am” is needed. Add mesh before the adjective for “not ready”.",
      "examples": [
        {
          "id": "ai-news-2026-10-10-ar-EG-s029",
          "text": "أنا هاخد الملف ده.",
          "english": "I will take this file.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "ana haakhod el-malaff da."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s030",
          "text": "أنا جاهزة.",
          "english": "I am ready.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "ana gahza."
        },
        {
          "id": "ai-news-2026-10-10-ar-EG-s031",
          "text": "أنا مش جاهز.",
          "english": "I am not ready.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "ana mesh gahez."
        }
      ]
    }
