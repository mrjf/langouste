    {
      "id": "ai-news-2026-10-10-hu-r2",
      "title": "Read the instructions · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-10-hu-s004",
          "text": "Anna: Hol az útmutató?",
          "english": "Anna: Where is the guide?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s005",
          "text": "Bence: Itt van, a képernyőn.",
          "english": "Bence: Here it is, on the screen.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s006",
          "text": "Anna: Először elolvasom az utasítást.",
          "english": "Anna: First I read the instruction.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s007",
          "text": "Bence: Van benne példa?",
          "english": "Bence: Is there an example in it?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s008",
          "text": "Anna: Igen, itt egy rövid példa.",
          "english": "Anna: Yes, here is a short example.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s009",
          "text": "Bence: Utána kipróbálom.",
          "english": "Bence: I will try it afterwards.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    },
    {
      "id": "ai-news-2026-10-10-hu-r3",
      "title": "Check one step · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-10-hu-s010",
          "text": "Anna: Melyik lépés nehéz?",
          "english": "Anna: Which step is difficult?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s011",
          "text": "Bence: Ez a lépés. Nem értem.",
          "english": "Bence: This step. I do not understand.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s012",
          "text": "Anna: Nézzük meg a példát!",
          "english": "Anna: Let us look at the example!",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s013",
          "text": "Bence: Most már értem.",
          "english": "Bence: Now I understand.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s014",
          "text": "Anna: Kész az első feladat?",
          "english": "Anna: Is the first task finished?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s015",
          "text": "Bence: Igen, kész. Jöhet a következő.",
          "english": "Bence: Yes, it is finished. Next one, please.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    }
