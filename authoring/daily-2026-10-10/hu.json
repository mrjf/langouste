  "concepts": [
    {
      "id": "hu-oct10-grammar-1",
      "title": "First read, then try",
      "explanation": "Először means first; utána means afterwards. Put either at the start to order actions. Elolvasom and kipróbálom refer to a specific object: I read it through; I try it out. With an explicit object use -t: az utasítást, a példát.",
      "examples": [
        {
          "id": "ai-news-2026-10-10-hu-s026",
          "text": "Először elolvasom az utasítást.",
          "english": "First I read the instruction.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s027",
          "text": "Utána kipróbálom.",
          "english": "I try it afterwards.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s028",
          "text": "Elolvasom a példát.",
          "english": "I read the example.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    },
    {
      "id": "hu-oct10-grammar-2",
      "title": "Describe a step",
      "explanation": "Melyik lépés nehéz? asks which step is difficult. Ez a lépés nehéz identifies this step. Nem before the adjective makes it negative. There is no separate “is” in these third-person present descriptions.",
      "examples": [
        {
          "id": "ai-news-2026-10-10-hu-s029",
          "text": "Melyik lépés nehéz?",
          "english": "Which step is difficult?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s030",
          "text": "Ez a lépés nehéz.",
          "english": "This step is difficult.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-10-hu-s031",
          "text": "Ez a lépés nem nehéz.",
          "english": "This step is not difficult.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    }
  ],
