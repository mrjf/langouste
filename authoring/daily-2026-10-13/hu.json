  "concepts": [
    {
      "id": "hu-oct13-grammar-1",
      "title": "Something is needed",
      "explanation": "Kell plus a noun says something is needed: kell egy frissítés. Nem kell negates it. It does not identify who needs it. In a question, intonation makes Kell egy frissítés? mean Is an update needed?",
      "examples": [
        {
          "id": "ai-news-2026-10-13-hu-s026",
          "text": "Kell egy frissítés.",
          "english": "An update is needed.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s027",
          "text": "Nem kell új program.",
          "english": "A new program is not needed.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s028",
          "text": "Kell egy frissítés?",
          "english": "Is an update needed?",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    },
    {
      "id": "hu-oct13-grammar-2",
      "title": "Close it and restart it",
      "explanation": "Bezárom and újraindítom are first-person definite forms: I close it and I restart it. The specific object has -t: a programot. Use először and utána to give the sequence. Később means later without specifying an exact time.",
      "examples": [
        {
          "id": "ai-news-2026-10-13-hu-s029",
          "text": "Először bezárom a programot.",
          "english": "First I close the program.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s030",
          "text": "Utána újraindítom a programot.",
          "english": "Then I restart the program.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s031",
          "text": "Később kezdjük.",
          "english": "We start later.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    }
  ],
