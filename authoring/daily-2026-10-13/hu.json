  "sources": [
    {
      "id": "github_settings_2026_10_13",
      "title": "Enterprise managed settings enforcement updates",
      "url": "https://github.blog/changelog/2026-10-13-enterprise-managed-settings-enforcement-updates/",
      "publishedOn": "2026-10-13",
      "verifiedAsOf": "2026-10-13",
      "publisher": "GitHub",
      "factSummary": "Enterprise administrators can require supported Copilot clients to retrieve current managed settings at startup. With this requirement enabled, a client stops if it cannot confirm current policy; this is not the default for every user."
    }
  ],
  "readings": [
    {
      "id": "ai-news-2026-10-13-hu-r1",
      "title": "Current settings at startup · October 13 announcement",
      "sentences": [
        {
          "id": "ai-news-2026-10-13-hu-s001",
          "text": "A GitHub új beállítást jelentett be.",
          "english": "GitHub announced a new setting.",
          "kind": "source-summary",
          "sourceIds": [
            "github_settings_2026_10_13"
          ]
        },
        {
          "id": "ai-news-2026-10-13-hu-s002",
          "text": "A rendszergazda friss szabályokat kérhet a Copilot indításakor.",
          "english": "The administrator can require current rules when Copilot starts.",
          "kind": "source-summary",
          "sourceIds": [
            "github_settings_2026_10_13"
          ]
        },
        {
          "id": "ai-news-2026-10-13-hu-s003",
          "text": "Ezzel a beállítással a program csak ellenőrzött szabályokkal indul.",
          "english": "With this setting, the program starts only with verified rules.",
          "kind": "source-summary",
          "sourceIds": [
            "github_settings_2026_10_13"
          ]
        }
      ]
    },
    {
      "id": "ai-news-2026-10-13-hu-r2",
      "title": "Which version? · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-13-hu-s004",
          "text": "Anna: Melyik verzió van a gépen?",
          "english": "Anna: Which version is on the computer?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s005",
          "text": "Bence: A régi verzió.",
          "english": "Bence: The old version.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s006",
          "text": "Anna: Kell egy frissítés.",
          "english": "Anna: An update is needed.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s007",
          "text": "Bence: Most vagy később?",
          "english": "Bence: Now or later?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s008",
          "text": "Anna: Először bezárom a programot.",
          "english": "Anna: First I close the program.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s009",
          "text": "Bence: Rendben, utána frissítünk.",
          "english": "Bence: Okay, then we update.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    },
    {
      "id": "ai-news-2026-10-13-hu-r3",
      "title": "Start again · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-13-hu-s010",
          "text": "Anna: Kész a frissítés?",
          "english": "Anna: Is the update finished?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s011",
          "text": "Bence: Igen. Újraindítom a programot.",
          "english": "Bence: Yes. I restart the program.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s012",
          "text": "Anna: Hol vannak a beállítások?",
          "english": "Anna: Where are the settings?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s013",
          "text": "Bence: Itt, ebben a menüben.",
          "english": "Bence: Here, in this menu.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s014",
          "text": "Anna: Most jó a verzió.",
          "english": "Anna: The version is correct now.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-13-hu-s015",
          "text": "Bence: Akkor kezdhetjük.",
          "english": "Bence: Then we can start.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    }
