      "title": "Code scanning AI Scan metrics in security overview",
      "url": "https://github.blog/changelog/2026-10-13-code-scanning-ai-scan-metrics-in-security-overview/",
      "publishedOn": "2026-10-13",
      "verifiedAsOf": "2026-10-13",
      "publisher": "GitHub",
      "factSummary": "GitHub added AI Scan metrics showing findings, resolutions and trends to security overview. This is a public preview for eligible GitHub Code Security or Advanced Security customers on github.com, not all deployments."
    }
  ],
  "readings": [
    {
      "id": "ai-news-2026-10-13-ar-EG-r1",
      "title": "Count AI Scan findings · October 13 preview",
      "sentences": [
        {
          "id": "ai-news-2026-10-13-ar-EG-s001",
          "text": "GitHub أضافت إحصائيات جديدة لأداة AI Scan.",
          "english": "GitHub added new statistics for AI Scan.",
          "kind": "source-summary",
          "sourceIds": [
            "github_ai_scan_metrics_2026_10_13"
          ],
          "transliteration": "GitHub adaafet ehsaaʾeyyaat gedeeda le-adaa AI Scan."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s002",
          "text": "الإحصائيات بتعرض عدد المشاكل واللي اتحل منها.",
          "english": "The statistics show the number of issues and how many were resolved.",
          "kind": "source-summary",
          "sourceIds": [
            "github_ai_scan_metrics_2026_10_13"
          ],
          "transliteration": "el-ehsaaʾeyyaat beteʿred ʿadad el-mashaakel wel-li ethall menha."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s003",
          "text": "الميزة تجريبية ومش متاحة لكل العملاء.",
          "english": "The feature is in preview and is not available to all customers.",
          "kind": "source-summary",
          "sourceIds": [
            "github_ai_scan_metrics_2026_10_13"
          ],
          "transliteration": "el-meeza tagreebeyya we-mesh motaaha le-koll el-ʿomala."
        }
      ]
    },
    {
      "id": "ai-news-2026-10-13-ar-EG-r2",
      "title": "Read the numbers · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-13-ar-EG-s004",
          "text": "منى: كام مشكلة في التقرير؟",
          "english": "Mona: How many issues are in the report?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: kaam moshkela fi et-taʾreer?"
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s005",
          "text": "كريم: تلات مشاكل.",
          "english": "Karim: Three issues.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: talaat mashaakel."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s006",
          "text": "منى: اتحل كام؟",
          "english": "Mona: How many have been resolved?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: ethall kaam?"
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s007",
          "text": "كريم: اتحلت مشكلة واحدة.",
          "english": "Karim: One issue has been resolved.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: ethallet moshkela waahda."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s008",
          "text": "منى: يبقى فاضل مشكلتين.",
          "english": "Mona: So there are two issues left.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: yebʾa faadel moshkelteen."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s009",
          "text": "كريم: صح، نراجعهم سوا.",
          "english": "Karim: Right, let us review them together.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: sahh, neraageʿhom sawa."
        }
      ]
    },
    {
      "id": "ai-news-2026-10-13-ar-EG-r3",
      "title": "Compare two reports · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-13-ar-EG-s010",
          "text": "منى: ده تقرير امبارح؟",
          "english": "Mona: Is this yesterday’s report?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: da taʾreer embaareh?"
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s011",
          "text": "كريم: لأ، ده تقرير النهارده.",
          "english": "Karim: No, this is today’s report.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: laʾ, da taʾreer en-naharda."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s012",
          "text": "منى: العدد أقل من امبارح.",
          "english": "Mona: The number is lower than yesterday.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: el-ʿadad aʾall men embaareh."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s013",
          "text": "كريم: أيوه، بس لسه في مشاكل.",
          "english": "Karim: Yes, but there are still issues.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: aywa, bass lissa fi mashaakel."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s014",
          "text": "منى: محتاجين وقت أكتر؟",
          "english": "Mona: Do we need more time?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: mehtaageen waʾt aktar?"
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s015",
          "text": "كريم: أيوه، شوية وقت.",
          "english": "Karim: Yes, a little time.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: aywa, shewayyet waʾt."
        }
      ]
    }
  ],
