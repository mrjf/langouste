  "concepts": [
    {
      "id": "ar-EG-oct13-grammar-1",
      "title": "How many? One, two, three",
      "explanation": "Kaam is followed by a singular noun in this question: kaam moshkela? One issue is moshkela waahda. Two uses the dual ending -teen: moshkelteen. With three use the plural: talaat mashaakel.",
      "examples": [
        {
          "id": "ai-news-2026-10-13-ar-EG-s026",
          "text": "كام مشكلة؟",
          "english": "How many issues?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "kaam moshkela?"
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s027",
          "text": "مشكلة واحدة.",
          "english": "One issue.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "moshkela waahda."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s028",
          "text": "مشكلتين.",
          "english": "Two issues.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "moshkelteen."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s029",
          "text": "تلات مشاكل.",
          "english": "Three issues.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "talaat mashaakel."
        }
      ]
    },
    {
      "id": "ar-EG-oct13-grammar-2",
      "title": "Less and more",
      "explanation": "Aʾall means less or fewer; aktar means more. Men introduces a comparison: aʾall men embaareh, less than yesterday. Waʾt aktar means more time. With el-ʿadad there is no separate present-tense is.",
      "examples": [
        {
          "id": "ai-news-2026-10-13-ar-EG-s030",
          "text": "العدد أقل من امبارح.",
          "english": "The number is lower than yesterday.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "el-ʿadad aʾall men embaareh."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s031",
          "text": "محتاجين وقت أكتر.",
          "english": "We need more time.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "mehtaageen waʾt aktar."
        },
        {
          "id": "ai-news-2026-10-13-ar-EG-s032",
          "text": "فاضل مشكلتين.",
          "english": "There are two issues left.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "faadel moshkelteen."
        }
      ]
    }
