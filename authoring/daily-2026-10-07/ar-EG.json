    {
      "id": "ai-news-2026-10-07-ar-EG-r2",
      "title": "A busy week · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-07-ar-EG-s004",
          "text": "منى: عندي مواعيد كتير.",
          "english": "Mona: I have lots of deadlines.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: ʿandi mawaaʿeed kiteer."
        },
        {
          "id": "ai-news-2026-10-07-ar-EG-s005",
          "text": "كريم: نعمل خطة؟",
          "english": "Karim: Shall we make a plan?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: neʿmel khetta?"
        },
        {
          "id": "ai-news-2026-10-07-ar-EG-s006",
          "text": "منى: أيوه، الأول نكتب قائمة.",
          "english": "Mona: Yes, first we write a list.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: aywa, el-awwal nekteb ʾaayma."
        },
        {
          "id": "ai-news-2026-10-07-ar-EG-s007",
          "text": "كريم: وبعدين نرتّب المواعيد.",
          "english": "Karim: And then we arrange the deadlines.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: wi-baʿdeen neratteb el-mawaaʿeed."
        },
        {
          "id": "ai-news-2026-10-07-ar-EG-s008",
          "text": "منى: الميعاد ده بكرة.",
          "english": "Mona: This deadline is tomorrow.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: el-meeʿaad da bokra."
        },
        {
          "id": "ai-news-2026-10-07-ar-EG-s009",
          "text": "كريم: طيب، نبدأ بده.",
          "english": "Karim: Okay, let’s start with this one.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: tayyeb, nebdaʾ be-da."
        }
      ]
    },
    {
      "id": "ai-news-2026-10-07-ar-EG-r3",
      "title": "One step at a time · Fictional dialogue",
      "sentences": [
        {
          "id": "ai-news-2026-10-07-ar-EG-s010",
          "text": "منى: القائمة طويلة.",
          "english": "Mona: The list is long.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: el-ʾaayma taweela."
        },
