          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Kareem: neʿmel khatwa waahda delwaʾti."
        },
        {
          "id": "ai-news-2026-10-07-ar-EG-s012",
          "text": "منى: وبعد كده؟",
          "english": "Mona: And after that?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "Mona: wi-baʿd keda?"
