  "concepts": [
    {
      "id": "ar-EG-oct07-grammar-1",
      "title": "Suggest a shared action",
      "explanation": "With these verbs, n- marks “we”: nekteb, “we write”, and neratteb, “we arrange”. In a question or suggestion, the same forms can mean “shall we…?” or “let’s…”. Put el-awwal (“first”) before the first action and wi-baʿdeen (“and then”) before the next.",
      "examples": [
        {
          "id": "ai-news-2026-10-07-ar-EG-s026",
          "text": "الأول نكتب قائمة.",
          "english": "First we write a list.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "el-awwal nekteb ʾaayma."
        },
        {
          "id": "ai-news-2026-10-07-ar-EG-s027",
          "text": "وبعدين نرتّب المواعيد.",
          "english": "And then we arrange the deadlines.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "wi-baʿdeen neratteb el-mawaaʿeed."
        }
      ]
    },
    {
      "id": "ar-EG-oct07-grammar-2",
      "title": "This one and one step",
      "explanation": "Put da after a definite masculine noun and di after a definite feminine noun. With a feminine noun, “one” is waahda and normally follows it. There is no separate present-tense word for “is” in these descriptions.",
      "examples": [
        {
          "id": "ai-news-2026-10-07-ar-EG-s028",
          "text": "الميعاد ده بكرة.",
          "english": "This deadline is tomorrow.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "el-meeʿaad da bokra."
        },
        {
          "id": "ai-news-2026-10-07-ar-EG-s029",
          "text": "الخطة دي بسيطة.",
          "english": "This plan is simple.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "el-khetta di baseeta."
        },
        {
          "id": "ai-news-2026-10-07-ar-EG-s030",
          "text": "خطوة واحدة",
          "english": "one step",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "khatwa waahda"
        }
      ]
