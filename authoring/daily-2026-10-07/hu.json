  "concepts": [
    {
      "id": "hu-oct07-grammar-1",
      "title": "A specific object: -t",
      "explanation": "Add an object ending when something is seen or changed. Szám becomes számot; kép becomes képet. With a specific object, learn the complete verb forms látom (“I see it”) and megváltoztatom (“I change it”). The object ending and the verb ending do different jobs.",
      "examples": [
        {
          "id": "ai-news-2026-10-07-hu-s026",
          "text": "Látom a számot.",
          "english": "I see the number.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-07-hu-s027",
          "text": "Megváltoztatom a számot.",
          "english": "I change the number.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-07-hu-s028",
          "text": "Látom a képet.",
          "english": "I see the picture.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    },
    {
      "id": "hu-oct07-grammar-2",
      "title": "Where it is; what it is like",
      "explanation": "Van appears when saying where something is: Itt van a gomb. For a third-person present description with an adjective, omit van: A gomb kicsi. Is means “also/too” and follows the item it includes.",
      "examples": [
        {
          "id": "ai-news-2026-10-07-hu-s029",
          "text": "Itt van a gomb.",
          "english": "Here is the button.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-07-hu-s030",
          "text": "A gomb kicsi.",
          "english": "The button is small.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-07-hu-s031",
          "text": "Egy kép is segít.",
          "english": "A picture helps too.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    }
  ],
