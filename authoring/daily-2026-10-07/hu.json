          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-07-hu-s006",
          "text": "Anna: Itt van.",
          "english": "Anna: Here it is.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-07-hu-s007",
          "text": "Bence: Látom a számot.",
          "english": "Bence: I see the number.",
