        {
          "id": "ai-news-2026-10-08-hu-s007",
          "text": "Bence: Két perc.",
          "english": "Bence: Two minutes.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-08-hu-s008",
          "text": "Anna: Itt van a jelentés.",
          "english": "Anna: Here is the report.",
          "kind": "teaching-example",
          "sourceIds": []
