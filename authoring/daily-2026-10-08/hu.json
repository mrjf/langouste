        },
        {
          "id": "ai-news-2026-10-08-hu-s005",
          "text": "Bence: Kérdezek egy kollégát.",
          "english": "Bence: I will ask a colleague.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-08-hu-s006",
          "text": "Anna: Mennyi idő kell?",
          "english": "Anna: How much time is needed?",
          "kind": "teaching-example",
          "sourceIds": []
