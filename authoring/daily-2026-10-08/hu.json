  "concepts": [
    {
      "id": "hu-oct08-grammar-1",
      "title": "Looking for something; checking a specific thing",
      "explanation": "Keresek is used here with an unspecified object: egy adatot, “a piece of data”. Ellenőrzöm is used with a specific object: az adatot, “the data”. Both objects take -t; the verb ending also reflects whether the object is specific. Learn the complete short phrases.",
      "examples": [
        {
          "id": "ai-news-2026-10-08-hu-s026",
          "text": "Egy adatot keresek.",
          "english": "I am looking for a piece of data.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-08-hu-s027",
          "text": "Ellenőrzöm az adatot.",
          "english": "I check the data.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-08-hu-s028",
          "text": "Kérdezek egy kollégát.",
          "english": "I ask a colleague.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    },
    {
      "id": "hu-oct08-grammar-2",
      "title": "Ask how much time is needed",
      "explanation": "Mennyi idő kell? means “How much time is needed?” After a number, Hungarian normally keeps the noun singular: két perc, “two minutes”. Kell expresses a need here; it does not change in these short examples.",
      "examples": [
        {
          "id": "ai-news-2026-10-08-hu-s029",
          "text": "Mennyi idő kell?",
          "english": "How much time is needed?",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-08-hu-s030",
          "text": "Két perc kell.",
          "english": "Two minutes are needed.",
          "kind": "teaching-example",
          "sourceIds": []
        },
        {
          "id": "ai-news-2026-10-08-hu-s031",
          "text": "Egy perc kell.",
          "english": "One minute is needed.",
          "kind": "teaching-example",
          "sourceIds": []
        }
      ]
    }
