  "concepts": [
    {
      "id": "ar-EG-oct08-grammar-1",
      "title": "Ask who and where",
      "explanation": "Meen asks “who”. In meen katab el-maʾaal?, katab is “wrote”. Feen asks “where” and often comes after the noun in a short question. No separate word for “is” is needed.",
      "examples": [
        {
          "id": "ai-news-2026-10-08-ar-EG-s026",
          "text": "مين كتب المقال؟",
          "english": "Who wrote the article?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "meen katab el-maʾaal?"
        },
        {
          "id": "ai-news-2026-10-08-ar-EG-s027",
          "text": "المصدر فين؟",
          "english": "Where is the source?",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "el-masdar feen?"
        }
      ]
    },
    {
      "id": "ar-EG-oct08-grammar-2",
      "title": "Make sure of something",
      "explanation": "Learn netʾakked men as a complete phrase: “we check / let’s make sure of”. Men introduces what you check. Lissa mesh means “still not”; a female speaker says metʾakkeda, and a male speaker says metʾakked.",
      "examples": [
        {
          "id": "ai-news-2026-10-08-ar-EG-s028",
          "text": "نتأكد من المصدر.",
          "english": "Let’s check the source.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "netʾakked men el-masdar."
        },
        {
          "id": "ai-news-2026-10-08-ar-EG-s029",
          "text": "لسه مش متأكدة.",
          "english": "I am still not sure.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "lissa mesh metʾakkeda."
        },
        {
          "id": "ai-news-2026-10-08-ar-EG-s030",
          "text": "لسه مش متأكد.",
          "english": "I am still not sure.",
          "kind": "teaching-example",
          "sourceIds": [],
          "transliteration": "lissa mesh metʾakked."
        }
      ]
    }
