{
  "name": "filo",
  "version": "0.1.0",
  "description": "Generic TypeScript annotation library for immutable text.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "build:web": "vite build --outDir dist-web",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run typecheck:web && bun run test",
    "scrape:nytimes": "bun run src/newspaper/nytimes.ts"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "6.0.3",
    "vite": "^6"
  }
}
